DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
# Optional console verbosity for django and board loggers (defaults: WARNING and INFO).
# DJANGO_LOG_LEVEL=INFO
DJANGO_ALLOWED_HOSTS=jobs.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobs.example.com
DATABASE_URL=postgresql://diplomacyjobs:replace-password@db:5432/diplomacyjobs
POSTGRES_PASSWORD=replace-password
PUBLIC_BASE_URL=https://jobs.example.com
# Enable once HTTPS works end to end; /health/ stays reachable over plain HTTP for the container healthcheck.
DJANGO_SECURE_SSL_REDIRECT=0
# Set after the hostname is final; start small (e.g. 3600). HSTS cannot be withdrawn from browsers that cached it.
DJANGO_HSTS_SECONDS=0
# Candidate accounts and all delivery stay off until the launch checks in
# docs/candidate-discovery.md are complete. Leave these at 0 for preview-only.
CANDIDATE_SIGNUP_ENABLED=0
CANDIDATE_MAIL_ENABLED=0
JOB_ALERTS_ENABLED=0
# Required before opening registration: identify the operator, privacy contact,
# and the actual mail provider in the public privacy notice.
CANDIDATE_OPERATOR_NAME=
CANDIDATE_PRIVACY_EMAIL=
CANDIDATE_EMAIL_PROCESSOR=
# Required only after account email has been tested with a real mailbox.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=
# Set to the alert launch date, not the registration date, when alerts open.
JOB_ALERTS_ACTIVE_SINCE=
